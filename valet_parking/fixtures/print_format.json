  "html": "<div style=\"max-width: 300px; margin: 0 auto; font-family: monospace; border: 1px dashed #000; padding: 14px;\">\r\n  <h3 style=\"text-align: center; margin: 0;\">VALET PARKING SLIP</h3>\r\n  <p style=\"text-align: center; font-size: 13px; margin: 4px 0 12px;\"><b>{{ doc.name }}</b></p>\r\n  <hr style=\"border-top: 1px dashed #000;\">\r\n  <p><b>Guest:</b> {{ doc.customer_name }}</p>\r\n  <p><b>Vehicle:</b> {{ doc.vehicle_plate_number }}</p>\r\n  <p><b>Spot:</b> {{ doc.parking_spot }}</p>\r\n  <p><b>Check-In:</b> {{ frappe.utils.format_datetime(doc.check_in_time, \"dd-MM-yyyy hh:mm a\") }}</p>\r\n  {% if doc.check_out_time %}\r\n  <p><b>Check-Out:</b> {{ frappe.utils.format_datetime(doc.check_out_time, \"dd-MM-yyyy hh:mm a\") }}</p>\r\n  {% endif %}\r\n  <hr style=\"border-top: 1px dashed #000;\">\r\n  {% if doc.total_fee %}\r\n  <h4 style=\"text-align: right; margin: 6px 0;\">Total: ₹ {{ \"%.2f\"|format(doc.total_fee) }}</h4>\r\n  {% endif %}\r\n  <p style=\"text-align: center; font-size: 11px; margin-top: 10px;\">Request your car online at:<br><b>/request-car</b></p>\r\n</div>\r\n",
