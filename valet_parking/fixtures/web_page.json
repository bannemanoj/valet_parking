  "main_section_html": "<div style=\"max-width: 420px; margin: 40px auto; padding: 24px; border: 1px solid #e2e8f0; border-radius: 12px; font-family: sans-serif;\">\r\n  <h2 style=\"text-align: center; margin-bottom: 8px;\">Request Your Vehicle</h2>\r\n  <p style=\"text-align: center; color: #64748b; font-size: 14px; margin-bottom: 20px;\">Enter your ticket details 5–10 minutes before leaving.</p>\r\n  <label style=\"font-weight: 600; font-size: 14px;\">Ticket Number</label>\r\n  <input id=\"ticket_id\" type=\"text\" placeholder=\"e.g. VLT-2026-00001\" style=\"width: 100%; padding: 10px; margin: 6px 0 16px; border: 1px solid #cbd5e1; border-radius: 6px;\">\r\n  <label style=\"font-weight: 600; font-size: 14px;\">Registered Phone Number</label>\r\n  <input id=\"phone_number\" type=\"tel\" placeholder=\"Enter your mobile number\" style=\"width: 100%; padding: 10px; margin: 6px 0 20px; border: 1px solid #cbd5e1; border-radius: 6px;\">\r\n  <button onclick=\"submitRequest()\" style=\"width: 100%; padding: 12px; background: #2563eb; color: #fff; border: none; border-radius: 6px; font-size: 16px; font-weight: 600; cursor: pointer;\">Request My Car</button>\r\n  <p id=\"status_msg\" style=\"margin-top: 16px; text-align: center; font-weight: 600;\"></p>\r\n</div>\r\n<script>\r\nfunction submitRequest() {\r\n  const msg = document.getElementById(\"status_msg\");\r\n  msg.style.color = \"#334155\";\r\n  msg.innerText = \"Sending request...\";\r\n  frappe.call({\r\n    method: \"valet_parking.api.request_vehicle\",\r\n    args: {\r\n      ticket_id: document.getElementById(\"ticket_id\").value,\r\n      phone_number: document.getElementById(\"phone_number\").value\r\n    },\r\n    callback: function(r) {\r\n      if (r.message && r.message.status === \"success\") {\r\n        msg.style.color = \"#16a34a\";\r\n        msg.innerText = r.message.message;\r\n      } else {\r\n        msg.style.color = \"#dc2626\";\r\n        msg.innerText = (r.message && r.message.message) || \"Could not process request.\";\r\n      }\r\n    }\r\n  });\r\n}\r\n</script>\r\n",
